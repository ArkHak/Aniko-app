<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>0.2.0</string>
	<key>CFBundleVersion</key>
	<string>4</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Обязательно для Compose Multiplatform: без этого ключа CMP на старте кидает
	     IllegalStateException (PlistSanityCheck) и приложение падает сразу после запуска.
	     Ключ снимает ограничение 60 Гц на устройствах с ProMotion. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- P10.T1: фоновый дренаж офлайн-очереди через BGAppRefreshTask. Оба ключа обязательны:
	     без `fetch` в UIBackgroundModes система никогда не запустит задачу, без идентификатора в
	     BGTaskSchedulerPermittedIdentifiers `submitTaskRequest` отвечает
	     BGTaskSchedulerErrorCodeNotPermitted. Значение должно совпадать с
	     `BackgroundSyncScheduler.SYNC_TASK_IDENTIFIER` в commonMain. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.aniko.app.sync-queue-drain</string>
	</array>
	<!-- ATS (issue #109): раньше стояло `NSAllowsArbitraryLoads = true` — cleartext разрешён для
	     ВСЕГО трафика приложения, включая API с токеном сессии. Нативный сетевой код (Ktor/Darwin:
	     API `api-s.anixsekai.com`, CDN картинок `s.anixmirai.com`) целиком ходит по https, живые
	     сэмплы `docs/api/samples/` не содержат ни одного http-хоста, который приложение реально
	     запрашивает, — поэтому для него ATS снова строгий.
	     Исключения оставлены только там, где содержимое не наше и его хосты заранее неизвестны:
	     - `NSAllowsArbitraryLoadsInWebContent` — страницы embed-плееров в `WKWebView` (Kodik, Sibnet,
	       Libria/Liberty, RuTube, VK Видео) вместе с их рекламными фреймами и подресурсами;
	     - `NSAllowsArbitraryLoadsForMedia` — медиапотоки (mp4/HLS), которые эти страницы отдают
	       медиастеку через `<video>`.
	     Оба ключа действуют только если `NSAllowsArbitraryLoads` отсутствует (иначе игнорируются). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
		<key>NSAllowsArbitraryLoadsForMedia</key>
		<true/>
	</dict>
	<!-- Deep links (P10.T7): custom scheme `aniko://release/...`, обрабатывается в
	     `iOSApp.swift` (`.onOpenURL`) -> `DeepLinkEntryKt.handleDeepLinkUrl` (composeApp/iosMain) ->
	     единый парсер `DeepLink.kt` (commonMain). `https://` App Links сюда намеренно не входят —
	     нет домена под контролем проекта для `apple-app-site-association`, см. KDoc `DeepLink.kt`. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.aniko.app.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>aniko</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
